# Kopiraj u .env (ista mapa) i upiši vrijednosti. .env se NE commita (u .gitignore je).
# Radar (python -m radar serve) ga sam ponovno učita kad ga spremiš.

# Banijska (privatna liga): Chrome → espn.com (prijavljen) → F12 → Application → Cookies → https://www.espn.com
ESPN_S2=
ESPN_SWID=

# Telegram: @BotFather → /newbot → token. Chat id: `python -m radar telegram` nakon što botu pošalješ poruku.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcionalno
ANTHROPIC_API_KEY=
# GITHUB_TOKEN=   (nije potreban ako je `gh` prijavljen: dashboard podaci idu preko `gh auth token`)
